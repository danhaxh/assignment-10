from tkinter import *
import RPi.GPIO as GPIO

# Set up LEDs
GPIO.setmode(GPIO.BCM)

GPIO.setup(17, GPIO.OUT)  # Green
GPIO.setup(27, GPIO.OUT)  # Red
GPIO.setup(22, GPIO.OUT)  # Blue

GPIO.output(17, GPIO.LOW)
GPIO.output(27, GPIO.LOW)
GPIO.output(22, GPIO.LOW)

username = "Daniel"
password = 123
count = 0

# Create the window
root = Tk()
root.title("Login Window Project")

Label(root, text="Username").grid(row=0, column=0,
                                  padx=20, pady=20)

e = Entry(root, width=25, borderwidth=5)
e.grid(row=0, column=1, padx=20, pady=20)

Label(root, text="Password").grid(row=1, column=0,
                                  padx=20, pady=20)

e2 = Entry(root, width=25, borderwidth=5)
e2.grid(row=1, column=1, padx=20, pady=20)

# Display the login result
e3 = Entry(root, width=45, borderwidth=5)
e3.grid(row=3, column=0, columnspan=2, padx=10, pady=20)


def button_login():
    global count

    first_entry = e.get()
    second_entry = e2.get()

    e3.delete(0, END)

    if first_entry == username and second_entry == str(password):
        e3.insert(0, "Successfully Logged In")

        GPIO.output(17, GPIO.HIGH)
        GPIO.output(27, GPIO.LOW)

    else:
        e3.insert(0, "The username or password is incorrect!")

        GPIO.output(17, GPIO.LOW)
        GPIO.output(27, GPIO.HIGH)

        if second_entry != str(password):
            count = count + 1

    if count > 2:
        GPIO.output(22, GPIO.HIGH)


# Define the button
button_Login = Button(root, text="login", padx=20, pady=10,
                      fg="white", bg="blue", command=button_login)

button_Login.grid(row=2, column=1)

root.mainloop()
GPIO.cleanup()
